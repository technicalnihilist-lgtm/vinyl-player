{
  "name": "vinyl-player-desktop",
  "productName": "Vinyl Player",
  "version": "78.0.0",
  "private": true,
  "description": "Vinyl Player for Windows, macOS and Linux \u2014 a liquid-glass player for the music already on your device.",
  "author": "Raju",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "stage": "node scripts/stage.js",
    "start": "npm run stage && electron .",
    "dist:win": "npm run stage && electron-builder --win --publish never",
    "dist:mac": "npm run stage && electron-builder --mac --publish never",
    "dist:linux": "npm run stage && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hubclue.vinylplayer",
    "productName": "Vinyl Player",
    "copyright": "MIT licensed",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vinyl Player"
    },
    "portable": {
      "artifactName": "Vinyl-Player-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Vinyl Player ${version}",
      "artifactName": "Vinyl-Player-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "Vinyl-Player-${version}-linux-${arch}.tar.gz"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/technicalnihilist-lgtm/vinyl-player.git"
  },
  "homepage": "https://technicalnihilist-lgtm.github.io/vinyl-player/",
  "bugs": {
    "url": "https://github.com/technicalnihilist-lgtm/vinyl-player/issues"
  }
}
