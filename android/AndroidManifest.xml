<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hubclue.vinylplayer"
    android:versionCode="71"
    android:versionName="71.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="36" />

    <!-- The app plays the music already on the device, so it needs to read the
         media library. Android 13+ uses READ_MEDIA_AUDIO; older releases use
         READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- The now-playing card on the lock screen and in the notification shade.
         Android 13 and up ask the user before any notification may be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- No INTERNET permission: this is a fully offline player. It reads the
         device's own music and never talks to a network. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name="com.hubclue.vinylplayer.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
